+"use client";
+
+import { useEffect, useState } from "react";
+import { useKBTreeStore } from "@/stores/kb-tree-store";
+import { useKBEditorStore } from "@/stores/kb-editor-store";
+import { KBTreeView } from "./sidebar/kb-tree-view";
+import { KBEditor } from "./editor/kb-editor";
+import { ScrollArea } from "@multica/ui/components/ui/scroll-area";
+import { Button } from "@multica/ui/components/ui/button";
+import { Input } from "@multica/ui/components/ui/input";
+import {
+  Dialog,
+  DialogContent,
+  DialogHeader,
+  DialogTitle,
+} from "@multica/ui/components/ui/dialog";
+import { BookOpen, Plus, GripVertical } from "lucide-react";
+import { cn } from "@multica/ui/lib/utils";
+import type { TreeNode } from "@/lib/kb/tree-builder";
+
+type ViewMode = "editor" | "pdf" | "csv" | "image" | "video" | "audio" | "mermaid" | "code" | "website" | "unknown";
+
+function getViewMode(type: TreeNode["type"]): ViewMode {
+  if (type === "pdf") return "pdf";
+  if (type === "csv") return "csv";
+  if (type === "image") return "image";
+  if (type === "video" || type === "audio") return type;
+  if (type === "mermaid") return "mermaid";
+  if (type === "code") return "code";
+  if (type === "website" || type === "app") return "website";
+  if (type === "unknown") return "unknown";
+  return "editor";
+}
+
+export function KBShell() {
+  const loadTree = useKBTreeStore((s) => s.loadTree);
+  const createPage = useKBTreeStore((s) => s.createPage);
+  const selectPage = useKBTreeStore((s) => s.selectPage);
+  const loadPage = useKBEditorStore((s) => s.loadPage);
+  const clear = useKBEditorStore((s) => s.clear);
+
+  const [viewMode, setViewMode] = useState<ViewMode>("editor");
+  const [activePath, setActivePath] = useState<string | null>(null);
+  const [sidebarWidth, setSidebarWidth] = useState(260);
+  const [isResizing, setIsResizing] = useState(false);
+  const [newPageOpen, setNewPageOpen] = useState(false);
+  const [newPageTitle, setNewPageTitle] = useState("");
+  const [creating, setCreating] = useState(false);
+
+  useEffect(() => {
+    void loadTree();
+    const id = window.setInterval(() => void loadTree(), 10_000);
+    return () => window.clearInterval(id);
+  }, [loadTree]);
+
+  const handleNavigate = (path: string, type: TreeNode["type"]) => {
+    setActivePath(path);
+    setViewMode(getViewMode(type));
+    if (type === "file" || type === "directory") {
+      void loadPage(path);
+    }
+  };
+
+  const handleMouseDown = (e: React.MouseEvent) => {
+    e.preventDefault();
+    setIsResizing(true);
+    const startX = e.clientX;
+    const startWidth = sidebarWidth;
+
+    const onMouseMove = (ev: MouseEvent) => {
+      const next = Math.max(180, Math.min(480, startWidth + ev.clientX - startX));
+      setSidebarWidth(next);
+    };
+    const onMouseUp = () => {
+      setIsResizing(false);
+      document.removeEventListener("mousemove", onMouseMove);
+      document.removeEventListener("mouseup", onMouseUp);
+    };
+    document.addEventListener("mousemove", onMouseMove);
+    document.addEventListener("mouseup", onMouseUp);
+  };
+
+  const renderContent = () => {
+    if (!activePath) {
+      return (
+        <div className="flex flex-1 flex-col items-center justify-center gap-4 text-muted-foreground">
+          <BookOpen className="h-12 w-12 opacity-20" />
+          <p className="text-sm">Select a page or create a new one</p>
+          <Button size="sm" onClick={() => setNewPageOpen(true)}>
+            <Plus className="h-4 w-4 mr-1" />
+            New Page
+          </Button>
+        </div>
+      );
+    }
+
+    if (viewMode === "editor") {
+      return <KBEditor />;
+    }
+
+    if (viewMode === "pdf") {
+      return (
+        <div className="flex flex-1 overflow-hidden">
+          <iframe
+            src={`/api/kb/pages/${encodeURIComponent(activePath)}?raw=1`}
+            className="flex-1 border-0"
+            title="PDF viewer"
+          />
+        </div>
+      );
+    }
+
+    if (viewMode === "image") {
+      return (
+        <div className="flex flex-1 items-center justify-center overflow-auto p-8">
+          {/* eslint-disable-next-line @next/next/no-img-element */}
+          <img
+            src={`/api/kb/pages/${encodeURIComponent(activePath)}?raw=1`}
+            alt={activePath.split("/").pop() || "image"}
+            className="max-w-full max-h-full object-contain"
+          />
+        </div>
+      );
+    }
+
+    if (viewMode === "website") {
+      return (
+        <iframe
+          src={`/api/kb/pages/${encodeURIComponent(activePath)}?raw=1`}
+          className="flex-1 border-0 w-full h-full"
+          title="Website viewer"
+          sandbox="allow-scripts allow-same-origin"
+        />
+      );
+    }
+
+    return (
+      <div className="flex flex-1 items-center justify-center">
+        <div className="text-center text-muted-foreground">
+          <p className="text-sm">This file type cannot be previewed directly.</p>
+          <p className="text-xs mt-1 opacity-60">{activePath}</p>
+        </div>
+      </div>
+    );
+  };
+
+  return (
+    <div className="flex h-full overflow-hidden">
+      {/* Sidebar */}
+      <div
+        className="flex flex-col border-r border-border bg-sidebar shrink-0"
+        style={{ width: sidebarWidth }}
+      >
+        {/* Sidebar header */}
+        <div className="flex items-center justify-between px-4 py-3 border-b border-border">
+          <div className="flex items-center gap-2">
+            <BookOpen className="h-4 w-4 text-muted-foreground" />
+            <span className="text-sm font-semibold">Knowledge Base</span>
+          </div>
+          <Button
+            variant="ghost"
+            size="icon"
+            className="h-6 w-6"
+            onClick={() => setNewPageOpen(true)}
+            title="New Page"
+          >
+            <Plus className="h-4 w-4" />
+          </Button>
+        </div>
+
+        <KBTreeView
+          onNavigate={handleNavigate}
+          onNewPage={() => setNewPageOpen(true)}
+        />
+      </div>
+
+      {/* Resize handle */}
+      <div
+        onMouseDown={handleMouseDown}
+        className={cn(
+          "w-1 cursor-col-resize hover:bg-primary/20 transition-colors shrink-0",
+          isResizing && "bg-primary/30"
+        )}
+      />
+
+      {/* Main content */}
+      <div className="flex flex-1 flex-col overflow-hidden">
+        {renderContent()}
+      </div>
+
+      {/* New page dialog */}
+      <Dialog open={newPageOpen} onOpenChange={setNewPageOpen}>
+        <DialogContent className="sm:max-w-md">
+          <DialogHeader>
+            <DialogTitle>New Page</DialogTitle>
+          </DialogHeader>
+          <form
+            onSubmit={async (e) => {
+              e.preventDefault();
+              if (!newPageTitle.trim()) return;
+              setCreating(true);
+              try {
+                await createPage("", newPageTitle.trim());
+                const slug = newPageTitle.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
+                selectPage(slug);
+                await loadPage(slug);
+                handleNavigate(slug, "file");
+                setNewPageTitle("");
+                setNewPageOpen(false);
+              } catch (error) {
+                console.error("Failed to create page:", error);
+              } finally {
+                setCreating(false);
+              }
+            }}
+            className="flex gap-2"
+          >
+            <Input
+              placeholder="Page title..."
+              value={newPageTitle}
+              onChange={(e) => setNewPageTitle(e.target.value)}
+              autoFocus
+            />
+            <Button type="submit" disabled={!newPageTitle.trim() || creating}>
+              {creating ? "Creating..." : "Create"}
+            </Button>
+          </form>
+        </DialogContent>
+      </Dialog>
+    </div>
+  );
+}
