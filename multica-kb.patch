+"use client";
+
+import { useKBEditorStore } from "@/stores/kb-editor-store";
+import { useKBTreeStore } from "@/stores/kb-tree-store";
+import { ContentEditor } from "@multica/views/editor";
+
+export function KBEditor() {
+  const { currentPath, content, saveStatus } = useKBEditorStore();
+  const updateContent = useKBEditorStore((s) => s.updateContent);
+  const selectedPath = useKBTreeStore((s) => s.selectedPath);
+
+  if (!selectedPath || !currentPath) {
+    return (
+      <div className="flex flex-1 items-center justify-center text-sm text-muted-foreground">
+        Select a page to edit
+      </div>
+    );
+  }
+
+  if (saveStatus === "error" && !content) {
+    return (
+      <div className="flex flex-1 items-center justify-center text-sm text-muted-foreground">
+        Failed to load page.
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-1 flex-col overflow-hidden">
+      <div className="flex items-center justify-end px-4 py-1 text-[11px] text-muted-foreground/60 border-b border-border/40">
+        {saveStatus === "saving" && "Saving..."}
+        {saveStatus === "saved" && "Saved"}
+        {saveStatus === "error" && "Save failed"}
+      </div>
+      <div className="flex-1 overflow-y-auto px-8 py-6 max-w-4xl mx-auto w-full">
+        <ContentEditor
+          key={currentPath}
+          defaultValue={content}
+          onUpdate={updateContent}
+          placeholder="Start writing..."
+          className="min-h-[60vh]"
+        />
+      </div>
+    </div>
+  );
+}
