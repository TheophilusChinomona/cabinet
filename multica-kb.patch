+"use client";
+
+import { useState, useMemo } from "react";
+import { useKBTreeStore } from "@/stores/kb-tree-store";
+import { useKBEditorStore } from "@/stores/kb-editor-store";
+import { ScrollArea } from "@multica/ui/components/ui/scroll-area";
+import { KBTreeNode } from "./kb-tree-node";
+import {
+  ContextMenu,
+  ContextMenuContent,
+  ContextMenuItem,
+  ContextMenuTrigger,
+} from "@multica/ui/components/ui/context-menu";
+import {
+  Dialog,
+  DialogContent,
+  DialogHeader,
+  DialogTitle,
+} from "@multica/ui/components/ui/dialog";
+import { Input } from "@multica/ui/components/ui/input";
+import { Button } from "@multica/ui/components/ui/button";
+import {
+  ChevronRight,
+  Plus,
+  BookOpen,
+  FilePlus,
+} from "lucide-react";
+import { cn } from "@multica/ui/lib/utils";
+import type { TreeNode } from "@/lib/kb/tree-builder";
+
+interface KBTreeViewProps {
+  onNavigate: (path: string, type: TreeNode["type"]) => void;
+  onNewPage?: () => void;
+}
+
+export function KBTreeView({ onNavigate, onNewPage }: KBTreeViewProps) {
+  const { nodes, loading } = useKBTreeStore();
+  const selectPage = useKBTreeStore((s) => s.selectPage);
+  const createPage = useKBTreeStore((s) => s.createPage);
+  const loadPage = useKBEditorStore((s) => s.loadPage);
+
+  const [expanded, setExpanded] = useState(true);
+  const [subPageOpen, setSubPageOpen] = useState(false);
+  const [subPageTitle, setSubPageTitle] = useState("");
+  const [creating, setCreating] = useState(false);
+
+  const visibleNodes = useMemo(() => nodes, [nodes]);
+
+  if (loading) {
+    return (
+      <div className="flex items-center justify-center py-8 text-sm text-muted-foreground">
+        Loading...
+      </div>
+    );
+  }
+
+  const pad = (depth: number) => ({ paddingLeft: `${depth * 16 + 8}px` });
+
+  return (
+    <>
+      <ScrollArea className="flex-1 min-h-0">
+        <div className="py-1">
+          {/* -- Data section header -- */}
+          <div className="flex items-center gap-1.5 px-3 pt-2 pb-1 w-full" style={pad(0)}>
+            <button
+              onClick={() => setExpanded(!expanded)}
+              className="shrink-0 text-muted-foreground/50 hover:text-foreground/80 transition-colors"
+            >
+              <ChevronRight
+                className={cn(
+                  "h-3 w-3 shrink-0 transition-transform duration-150",
+                  expanded && "rotate-90"
+                )}
+              />
+            </button>
+            <ContextMenu>
+              <ContextMenuTrigger>
+                <button
+                  className="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground text-left flex items-center gap-1.5 hover:text-foreground/80 transition-colors"
+                >
+                  <BookOpen className="h-3.5 w-3.5 shrink-0" />
+                  Pages
+                </button>
+              </ContextMenuTrigger>
+              <ContextMenuContent>
+                <ContextMenuItem onClick={() => setSubPageOpen(true)}>
+                  <FilePlus className="h-4 w-4 mr-2" />
+                  Add Page
+                </ContextMenuItem>
+              </ContextMenuContent>
+            </ContextMenu>
+          </div>
+
+          {expanded && (
+            <>
+              {visibleNodes.length === 0 ? (
+                <button
+                  onClick={() => {
+                    if (onNewPage) {
+                      onNewPage();
+                    } else {
+                      setSubPageOpen(true);
+                    }
+                  }}
+                  className={cn(
+                    "flex items-center gap-1.5 w-full text-left py-1.5 px-2 text-[13px] rounded-md transition-colors",
+                    "hover:bg-accent/50"
+                  )}
+                  style={pad(2)}
+                >
+                  <span className="w-3.5" />
+                  <Plus className="h-4 w-4 shrink-0 text-muted-foreground" />
+                  Add your first page
+                </button>
+              ) : (
+                visibleNodes.map((node) => (
+                  <KBTreeNode
+                    key={node.path}
+                    node={node}
+                    depth={2}
+                    onNavigate={onNavigate}
+                  />
+                ))
+              )}
+            </>
+          )}
+        </div>
+      </ScrollArea>
+
+      <Dialog open={subPageOpen} onOpenChange={setSubPageOpen}>
+        <DialogContent className="sm:max-w-md">
+          <DialogHeader>
+            <DialogTitle>New Page</DialogTitle>
+          </DialogHeader>
+          <form
+            onSubmit={async (e) => {
+              e.preventDefault();
+              if (!subPageTitle.trim()) return;
+              setCreating(true);
+              try {
+                await createPage("", subPageTitle.trim());
+                const slug = subPageTitle.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
+                selectPage(slug);
+                await loadPage(slug);
+                onNavigate(slug, "file");
+                setSubPageTitle("");
+                setSubPageOpen(false);
+              } catch (error) {
+                console.error("Failed to create page:", error);
+              } finally {
+                setCreating(false);
+              }
+            }}
+            className="flex gap-2"
+          >
+            <Input
+              placeholder="Page title..."
+              value={subPageTitle}
+              onChange={(e) => setSubPageTitle(e.target.value)}
+              autoFocus
+            />
+            <Button type="submit" disabled={!subPageTitle.trim() || creating}>
+              {creating ? "Creating..." : "Create"}
+            </Button>
+          </form>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
