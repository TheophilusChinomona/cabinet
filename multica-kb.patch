diff --git a/apps/web/stores/kb-editor-store.ts b/apps/web/stores/kb-editor-store.ts
new file mode 100644
index 00000000..465cc975
--- /dev/null
+++ b/apps/web/stores/kb-editor-store.ts
@@ -0,0 +1,119 @@
+import { create } from "zustand";
+import type { FrontMatter, PageData } from "@/lib/kb/page-io";
+
+type SaveStatus = "idle" | "saving" | "saved" | "error";
+
+interface EditorState {
+  currentPath: string | null;
+  content: string;
+  frontmatter: FrontMatter | null;
+  saveStatus: SaveStatus;
+  isDirty: boolean;
+
+  loadPage: (path: string) => Promise<void>;
+  updateContent: (content: string) => void;
+  updateFrontmatter: (updates: Partial<FrontMatter>) => void;
+  save: () => Promise<void>;
+  clear: () => void;
+}
+
+let saveTimer: ReturnType<typeof setTimeout> | null = null;
+let statusTimer: ReturnType<typeof setTimeout> | null = null;
+
+async function fetchPage(path: string): Promise<PageData> {
+  const res = await fetch(`/api/kb/pages/${encodeURIComponent(path)}`);
+  if (!res.ok) throw new Error(`HTTP ${res.status}`);
+  return res.json() as Promise<PageData>;
+}
+
+async function savePage(
+  path: string,
+  content: string,
+  frontmatter: Partial<FrontMatter>
+): Promise<void> {
+  const res = await fetch(`/api/kb/pages/${encodeURIComponent(path)}`, {
+    method: "PUT",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ content, frontmatter }),
+  });
+  if (!res.ok) throw new Error(`HTTP ${res.status}`);
+}
+
+export const useKBEditorStore = create<EditorState>((set, get) => ({
+  currentPath: null,
+  content: "",
+  frontmatter: null,
+  saveStatus: "idle",
+  isDirty: false,
+
+  loadPage: async (path: string) => {
+    if (saveTimer) clearTimeout(saveTimer);
+    if (statusTimer) clearTimeout(statusTimer);
+
+    try {
+      const page = await fetchPage(path);
+      set({
+        currentPath: path,
+        content: page.content,
+        frontmatter: page.frontmatter,
+        saveStatus: "idle",
+        isDirty: false,
+      });
+    } catch {
+      set({
+        currentPath: path,
+        content: "",
+        frontmatter: null,
+        saveStatus: "error",
+        isDirty: false,
+      });
+    }
+  },
+
+  updateContent: (content: string) => {
+    set({ content, isDirty: true });
+    if (saveTimer) clearTimeout(saveTimer);
+    saveTimer = setTimeout(() => {
+      void get().save();
+    }, 500);
+  },
+
+  updateFrontmatter: (updates: Partial<FrontMatter>) => {
+    const { frontmatter } = get();
+    if (!frontmatter) return;
+    set({ frontmatter: { ...frontmatter, ...updates }, isDirty: true });
+    if (saveTimer) clearTimeout(saveTimer);
+    saveTimer = setTimeout(() => {
+      void get().save();
+    }, 500);
+  },
+
+  save: async () => {
+    const { currentPath, content, frontmatter, isDirty } = get();
+    if (!currentPath || !isDirty) return;
+
+    set({ saveStatus: "saving" });
+    try {
+      await savePage(currentPath, content, frontmatter || {});
+      set({ saveStatus: "saved", isDirty: false });
+      if (statusTimer) clearTimeout(statusTimer);
+      statusTimer = setTimeout(() => {
+        set({ saveStatus: "idle" });
+      }, 2000);
+    } catch {
+      set({ saveStatus: "error" });
+    }
+  },
+
+  clear: () => {
+    if (saveTimer) clearTimeout(saveTimer);
+    if (statusTimer) clearTimeout(statusTimer);
+    set({
+      currentPath: null,
+      content: "",
+      frontmatter: null,
+      saveStatus: "idle",
+      isDirty: false,
+    });
+  },
+}));
diff --git a/apps/web/stores/kb-tree-store.ts b/apps/web/stores/kb-tree-store.ts
new file mode 100644
index 00000000..a67f17b2
--- /dev/null
+++ b/apps/web/stores/kb-tree-store.ts
@@ -0,0 +1,189 @@
+import { create } from "zustand";
+import type { TreeNode } from "@/lib/kb/tree-builder";
+
+interface TreeState {
+  nodes: TreeNode[];
+  selectedPath: string | null;
+  expandedPaths: Set<string>;
+  loading: boolean;
+  dragOverPath: string | null;
+  showHiddenFiles: boolean;
+
+  loadTree: () => Promise<void>;
+  selectPage: (path: string | null) => void;
+  toggleExpand: (path: string) => void;
+  expandPath: (path: string) => void;
+  createPage: (parentPath: string, title: string) => Promise<void>;
+  deletePage: (path: string) => Promise<void>;
+  movePage: (fromPath: string, toParentPath: string) => Promise<void>;
+  renamePage: (path: string, newName: string) => Promise<void>;
+  setDragOver: (path: string | null) => void;
+  setShowHiddenFiles: (show: boolean) => void;
+  toggleHiddenFiles: () => void;
+}
+
+function loadExpandedPaths(): Set<string> {
+  if (typeof window === "undefined") return new Set();
+  try {
+    const stored = localStorage.getItem("kb-expanded-paths");
+    return stored ? new Set(JSON.parse(stored) as string[]) : new Set();
+  } catch {
+    return new Set();
+  }
+}
+
+function loadShowHiddenFiles(): boolean {
+  if (typeof window === "undefined") return false;
+  try {
+    return localStorage.getItem("kb-show-hidden-files") === "true";
+  } catch {
+    return false;
+  }
+}
+
+function saveExpandedPaths(paths: Set<string>) {
+  if (typeof window === "undefined") return;
+  localStorage.setItem("kb-expanded-paths", JSON.stringify([...paths]));
+}
+
+async function apiFetch(path: string, options?: RequestInit) {
+  const res = await fetch(path, options);
+  if (!res.ok) {
+    const body = (await res.json().catch(() => ({}))) as { error?: string };
+    throw new Error(body.error || `HTTP ${res.status}`);
+  }
+  return res.json();
+}
+
+export const useKBTreeStore = create<TreeState>((set, get) => ({
+  nodes: [],
+  selectedPath: null,
+  expandedPaths: loadExpandedPaths(),
+  loading: false,
+  dragOverPath: null,
+  showHiddenFiles: loadShowHiddenFiles(),
+
+  loadTree: async () => {
+    set({ loading: true });
+    try {
+      const { showHiddenFiles } = get();
+      const nodes = (await apiFetch(
+        `/api/kb/tree${showHiddenFiles ? "?showHidden=true" : ""}`
+      )) as TreeNode[];
+      set({ nodes, loading: false });
+    } catch {
+      set({ loading: false });
+    }
+  },
+
+  selectPage: (path: string | null) => {
+    set({ selectedPath: path });
+  },
+
+  toggleExpand: (path: string) => {
+    const { expandedPaths } = get();
+    const next = new Set(expandedPaths);
+    if (next.has(path)) {
+      next.delete(path);
+    } else {
+      next.add(path);
+    }
+    set({ expandedPaths: next });
+    saveExpandedPaths(next);
+  },
+
+  expandPath: (path: string) => {
+    const { expandedPaths } = get();
+    if (!expandedPaths.has(path)) {
+      const next = new Set(expandedPaths);
+      next.add(path);
+      set({ expandedPaths: next });
+      saveExpandedPaths(next);
+    }
+  },
+
+  createPage: async (parentPath: string, title: string) => {
+    const slug = title
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, "-")
+      .replace(/^-|-$/g, "");
+    const fullPath = parentPath ? `${parentPath}/${slug}` : slug;
+    await apiFetch("/api/kb/pages", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ path: fullPath, title }),
+    });
+    if (parentPath) {
+      get().expandPath(parentPath);
+    }
+    await get().loadTree();
+    set({ selectedPath: fullPath });
+  },
+
+  deletePage: async (path: string) => {
+    await apiFetch(`/api/kb/pages/${encodeURIComponent(path)}`, { method: "DELETE" });
+    const { selectedPath } = get();
+    if (selectedPath === path) {
+      set({ selectedPath: null });
+    }
+    await get().loadTree();
+  },
+
+  movePage: async (fromPath: string, toParentPath: string) => {
+    try {
+      const { newPath } = (await apiFetch(
+        `/api/kb/pages/${encodeURIComponent(fromPath)}`,
+        {
+          method: "PATCH",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ action: "move", toParentPath }),
+        }
+      )) as { newPath: string };
+      if (toParentPath) {
+        get().expandPath(toParentPath);
+      }
+      await get().loadTree();
+      const { selectedPath } = get();
+      if (selectedPath === fromPath) {
+        set({ selectedPath: newPath });
+      }
+    } catch (error) {
+      console.error("Failed to move page:", error);
+    }
+  },
+
+  renamePage: async (pagePath: string, newName: string) => {
+    try {
+      const { newPath } = (await apiFetch(
+        `/api/kb/pages/${encodeURIComponent(pagePath)}`,
+        {
+          method: "PATCH",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ action: "rename", newName }),
+        }
+      )) as { newPath: string };
+      await get().loadTree();
+      const { selectedPath } = get();
+      if (selectedPath === pagePath) {
+        set({ selectedPath: newPath });
+      }
+    } catch (error) {
+      console.error("Failed to rename page:", error);
+    }
+  },

+  setDragOver: (path: string | null) => {
+    set({ dragOverPath: path });
+  },
+
+  setShowHiddenFiles: (show: boolean) => {
+    set({ showHiddenFiles: show });
+    localStorage.setItem("kb-show-hidden-files", String(show));
+    void get().loadTree();
+  },
+
+  toggleHiddenFiles: () => {
+    const { showHiddenFiles } = get();
+    get().setShowHiddenFiles(!showHiddenFiles);
+  },
+}));
