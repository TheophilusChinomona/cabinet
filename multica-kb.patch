@@ -0,0 +1,16 @@
+import { NextResponse } from "next/server";
+import { buildTree } from "@/lib/kb/tree-builder";
+import { ensureDataDir } from "@/lib/kb/fs-operations";
+
+export async function GET(request: Request) {
+  try {
+    await ensureDataDir();
+    const { searchParams } = new URL(request.url);
+    const showHidden = searchParams.get("showHidden") === "true";
+    const nodes = await buildTree(showHidden);
+    return NextResponse.json(nodes);
+  } catch (error) {
+    console.error("KB tree error:", error);
+    return NextResponse.json({ error: "Failed to build tree" }, { status: 500 });
+  }
+}
