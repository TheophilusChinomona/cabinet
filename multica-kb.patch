+import { NextResponse } from "next/server";
+import { createPage } from "@/lib/kb/page-io";
+
+export async function POST(request: Request) {
+  try {
+    const { path: virtualPath, title } = (await request.json()) as {
+      path: string;
+      title: string;
+    };
+
+    if (!virtualPath || !title) {
+      return NextResponse.json({ error: "path and title are required" }, { status: 400 });
+    }
+
+    await createPage(virtualPath, title);
+    return NextResponse.json({ success: true });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "Unknown error";
+    return NextResponse.json({ error: message }, { status: 500 });
+  }
+}
